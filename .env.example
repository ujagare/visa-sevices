# Vercel Environment Variables for White Wings Visa Website
# Add these variables in Vercel Dashboard -> Settings -> Environment Variables

# REQUIRED: Resend API for Email Delivery
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# OPTIONAL: Backup email services (if Resend fails)
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxx

# Production Settings
NODE_ENV=production
VERCEL_URL=https://your-domain.vercel.app

# Email Configuration
# All emails will be sent to: mrunal@whitewingsvisa.com
# Forms supported:
# - Home Contact Form (index.html)
# - Work Visa Forms (work.html)
# - Visit Visa Form (visit.html)
# - Migration Form (migrate.html)
# - Contact Page Form (contact-enhanced.html)